# === Your Claude subscription token (REQUIRED) ===
# Generate ONCE on your own computer (needs Claude Code installed + a Claude
# Pro/Max subscription):
#     claude setup-token
# It opens a browser, you log in, and it PRINTS a token valid for ~1 year.
# Paste that token here. No API key, no browser needed on the server.
CLAUDE_CODE_OAUTH_TOKEN=

# === Gate for this endpoint (REQUIRED) ===
# Any long random string YOU invent. Whoever knows it can spend your Claude
# subscription, so keep it secret. You put the SAME value into your bot as
# CLAUDE_CLI_TOKEN.
SHIM_TOKEN=

# === Optional ===
# Default model when the caller doesn't specify one. sonnet is a good balance;
# haiku is cheapest on the rate limit, opus is highest quality.
CLAUDE_MODEL=sonnet
# Railway sets PORT automatically; only set SHIM_PORT for local runs.
# SHIM_PORT=8899
