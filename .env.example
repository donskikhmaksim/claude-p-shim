# === Your Claude subscription token (REQUIRED) ===
# Generate ONCE on your own computer (needs Claude Code installed + a Claude
# Pro/Max subscription):
#     claude setup-token
# It opens a browser, you log in, and it PRINTS a token valid for ~1 year.
# Paste that token here. No API key, no browser needed on the server.
CLAUDE_CODE_OAUTH_TOKEN=

# === Two logins: primary + backup (optional, recommended) ===
# Calls go through PRIMARY; if its login fails (expired / revoked) or hits the usage limit, the same call is retried through
# BACKUP and the primary rests for SHIM_FAILOVER_COOLDOWN seconds. If BACKUP is empty, CLAUDE_CODE_OAUTH_TOKEN above is the
# backup — so adding a PRIMARY makes today's login the reserve. ISSUED_AT (YYYY-MM-DD) lets /status say when a token expires.
# CLAUDE_OAUTH_TOKEN_PRIMARY=
# CLAUDE_OAUTH_PRIMARY_ISSUED_AT=
# CLAUDE_OAUTH_TOKEN_BACKUP=
# CLAUDE_OAUTH_BACKUP_ISSUED_AT=
# SHIM_FAILOVER_COOLDOWN=600

# === Gate for this endpoint (REQUIRED) ===
# Any long random string YOU invent. Whoever knows it can spend your Claude
# subscription, so keep it secret. You put the SAME value into your bot as
# CLAUDE_CLI_TOKEN.
SHIM_TOKEN=

# === Optional ===
# Default model when the caller doesn't specify one. sonnet is a good balance;
# haiku is cheapest on the rate limit, opus is highest quality.
CLAUDE_MODEL=sonnet
# Railway sets PORT automatically; only set SHIM_PORT for local runs.
# SHIM_PORT=8899
